# =============================================================================
# AI-Powered Airline Customer Support System — environment configuration
# Copy this file to `.env` and fill in the values.  NOTHING here requires a
# paid account: Groq has a free tier (no card), and every other piece runs
# locally with no key at all.
# =============================================================================

# ------------------------------------------------------------------ LLM ------
# Provider for the language model. Options: "groq" (free tier) | "ollama" (fully local)
LLM_PROVIDER=groq

# --- Groq (free tier: https://console.groq.com/keys — signup, no credit card) ---
GROQ_API_KEY=
# Groq model name. Groq rotates its catalogue — if this one 404s, pick another
# from https://console.groq.com/docs/models  (e.g. llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Ollama (only used when LLM_PROVIDER=ollama; zero external accounts) ------
# Install: https://ollama.com  then:  ollama pull llama3.1
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1

LLM_TEMPERATURE=0

# ----------------------------------------------------------- EMBEDDINGS ------
# Local ONNX embeddings via fastembed — downloads once, then fully offline.
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# --------------------------------------------------------- VECTOR STORE ------
# "chroma" (local, no key — default) | "pinecone" (needs free Pinecone key)
VECTOR_STORE=chroma
CHROMA_DIR=./chroma_db

# --- Pinecone (only used when VECTOR_STORE=pinecone) --------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=airline-faq-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ------------------------------------------------------------ DATABASE -------
# Local dev points at the docker-compose Postgres below.
# For M5 / Hugging Face, repoint these at Supabase (or your cloud Postgres).
DB_HOST=localhost
DB_PORT=5432
DB_USER=airline
DB_PASSWORD=airline_pw
DB_NAME=airline

# --------------------------------------------------------------- API ---------
# Where the Streamlit frontend finds the FastAPI backend.
API_BASE_URL=http://localhost:8000
# Port the FastAPI backend listens on.
API_PORT=8000
# Port Streamlit listens on (7860 is the Hugging Face Spaces default).
STREAMLIT_PORT=8501
